# Gemini API Key (Optional for rule-based fallback mode, required for AI generation)
GEMINI_API_KEY=

# Gemini Model Name (easy to switch: gemini-2.5-flash, gemini-1.5-flash, gemini-flash-latest)
GEMINI_MODEL=gemini-flash-latest

# AI Request Timeout in seconds
AI_TIMEOUT_SECONDS=15

# Rate Limit (requests per minute per IP)
RATE_LIMIT_PER_MIN=30

# Trusted upstream proxies count (0 = disabled/safe direct socket IP; set to 1 for Cloud Run / reverse proxy)
TRUSTED_PROXY_COUNT=0

# Restrictive CORS Allowed Origins (comma-separated or JSON list)
ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
